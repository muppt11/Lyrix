    "instagram-graph-demo": "node instagram-graph-demo.js",
    "cron": "node cron-jobs.js",
    "cron-demo": "node cron-jobs-demo.js",
    "cron-start": "node -e \"require('./cron-jobs').startAllJobs()\"",
    "cron-stop": "node -e \"require('./cron-jobs').stopAllJobs()\"",
    "cron-status": "node -e \"require('./cron-jobs').getJobStatus().then(console.log)\"",
    "cron-logs": "tail -f logs/cron-jobs.log"
