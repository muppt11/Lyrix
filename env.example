# YouTube Data API Configuration
YOUTUBE_API_KEY=your_youtube_api_key_here

# Google Cloud Console Configuration
GOOGLE_CLOUD_PROJECT_ID=your_project_id_here
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json

# Optional: Service Account Key (JSON content as string)
GOOGLE_CLOUD_KEY_FILE=your_service_account_json_content_here

# Google Cloud Services Configuration
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_CLOUD_ZONE=us-central1-a

# BigQuery Configuration
BIGQUERY_DATASET_ID=your_dataset_id
BIGQUERY_TABLE_ID=your_table_id

# Cloud Storage Configuration
CLOUD_STORAGE_BUCKET=your_bucket_name

# Pub/Sub Configuration
PUBSUB_TOPIC_NAME=your_topic_name
PUBSUB_SUBSCRIPTION_NAME=your_subscription_name

# Social Media Analytics Configuration
# TikTok API (requires TikTok for Developers account)
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token

# Instagram Basic Display API
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

# Instagram Graph API (for Business/Creator accounts)
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_GRAPH_ACCESS_TOKEN=your_instagram_graph_access_token

# Analytics Configuration
ANALYTICS_DATA_RETENTION_DAYS=90
ANALYTICS_UPDATE_FREQUENCY_HOURS=6
ANALYTICS_TIMEZONE=UTC

# Web Scraping Configuration (for public data)
SCRAPING_ENABLED=true
SCRAPING_DELAY_MS=2000
SCRAPING_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Dashboard Configuration
DASHBOARD_PORT=3000
DASHBOARD_HOST=localhost
DASHBOARD_CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Notification Configuration
ENABLE_EMAIL_NOTIFICATIONS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password

# Enhanced Trending APIs Configuration
RAPIDAPI_KEY=your_rapidapi_key_here
SOCIALBLADE_API_KEY=your_socialblade_api_key_here
TRENDS24_API_KEY=your_trends24_api_key_here
GOOGLE_TRENDS_API_KEY=your_google_trends_api_key_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here

# Content Creator Specific Configuration
# Creator Profile
CREATOR_NAME=Your Creator Name
CREATOR_NICHE=Your Content Niche (e.g., gaming, lifestyle, tech, education)
CREATOR_LEVEL=nano|micro|macro|mega
CREATOR_PRIMARY_PLATFORM=youtube|tiktok|instagram|multi

# Content Strategy Settings
CONTENT_ANALYSIS_ENABLED=true
CONTENT_OPTIMIZATION_ENABLED=true
THUMBNAIL_ANALYSIS_ENABLED=true
TITLE_OPTIMIZATION_ENABLED=true
HASHTAG_ANALYSIS_ENABLED=true
POSTING_SCHEDULE_OPTIMIZATION_ENABLED=true

# Monetization Settings
MONETIZATION_ANALYSIS_ENABLED=true
SPONSORSHIP_VALUATION_ENABLED=true
AFFILIATE_MARKETING_ENABLED=true
MERCHANDISE_ANALYSIS_ENABLED=true
REVENUE_TRACKING_ENABLED=true

# Growth & Engagement Settings
GROWTH_PREDICTION_ENABLED=true
ENGAGEMENT_ANALYSIS_ENABLED=true
AUDIENCE_SEGMENTATION_ENABLED=true
COMPETITOR_ANALYSIS_ENABLED=true
TREND_ANALYSIS_ENABLED=true

# Creator Workflow Automation
AUTOMATED_REPORTS_ENABLED=true
CONTENT_CALENDAR_ENABLED=true
GROWTH_ALERTS_ENABLED=true
MONETIZATION_ALERTS_ENABLED=true
COMPETITOR_MONITORING_ENABLED=true

# Creator Dashboard Customization
DASHBOARD_THEME=light|dark|auto
DASHBOARD_LAYOUT=creator|business|analyst
DASHBOARD_REFRESH_INTERVAL=30000
DASHBOARD_CHARTS_ENABLED=true
DASHBOARD_EXPORT_ENABLED=true

# Creator API Endpoints
CREATOR_API_ENABLED=true
CREATOR_WEBHOOK_ENABLED=false
CREATOR_WEBHOOK_URL=your_webhook_url_here

# Creator Data Export
EXPORT_FORMATS=json,csv,pdf
EXPORT_SCHEDULE_ENABLED=false
EXPORT_SCHEDULE_CRON=0 9 * * 1
EXPORT_EMAIL_ENABLED=false

# Cron Job Configuration
REAL_TIME_TRENDING_SCHEDULE=*/3 * * * *
MULTI_PLATFORM_TRENDING_SCHEDULE=0 */4 * * *
INSTAGRAM_ANALYSIS_SCHEDULE=0 */8 * * *
SOCIAL_MEDIA_ANALYTICS_SCHEDULE=0 2 * * *
DATA_CLEANUP_SCHEDULE=0 3 * * 0
HEALTH_CHECK_SCHEDULE=*/30 * * * *
TIMEZONE=UTC
DATA_RETENTION_DAYS=30

# Channel Configuration for Analytics
YOUTUBE_CHANNEL_ID=your_youtube_channel_id_here
TIKTOK_USERNAME=your_tiktok_username_here
INSTAGRAM_USERNAME=your_instagram_username_here 