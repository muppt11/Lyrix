# Copy to .env.local (gitignored) and adjust as needed.

# mock = everything renders from static/sample data, no backend required.
# api  = pages that have been migrated (currently: /discover) call the
#        FastAPI service below for real data.
NEXT_PUBLIC_LYRA_DATA_MODE=mock

# Base URL of the api/ FastAPI service (see /api/README or run:
# uvicorn api.app.main:app --reload --port 8000 from the repo root).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
