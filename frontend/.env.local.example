# Copy to .env.local (gitignored) and adjust as needed.

# mock = use explicitly labeled sample data in migrated pages.
# api  = use the FastAPI service in migrated pages. Unmigrated analytics pages
#        remain on labeled sample data until their API endpoints are implemented.
NEXT_PUBLIC_LYRA_DATA_MODE=mock

# Base URL of the api/ FastAPI service (see /api/README or run:
# uvicorn api.app.main:app --reload --port 8000 from the repo root).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
